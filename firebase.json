{
  "hosting": {
    "site": "tvcesoir",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "programme-tv",
          "region": "europe-west2"
        }
      },
      {
        "source": "/sitemap.xml",
        "run": {
          "serviceId": "programme-tv",
          "region": "europe-west2"
        }
      },
      {
        "source": "/robots.txt",
        "run": {
          "serviceId": "programme-tv",
          "region": "europe-west2"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
